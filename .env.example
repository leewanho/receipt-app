# 영수증 읽기(AI) 설정 — Vercel 환경변수에 같은 이름으로 넣습니다
OCR_PROVIDER=gemini
# 무료 한도가 다 찼을 때 자동으로 넘어갈 곳 (비워두면 "잠시 후 다시" 안내만)
OCR_FALLBACK_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CLAUDE_MODEL=claude-haiku-5-5
# 아버지가 한 번 입력할 4자리 비밀번호
APP_PIN=1234
# 하루 최대 영수증 읽기 횟수
DAILY_LIMIT=60
# 하루 횟수 저장소 (Upstash Redis, Vercel Marketplace에서 연결하면 자동 생성)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
